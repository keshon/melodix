{
  "name": "melodix-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1 --port 5177 --strictPort",
    "prebuild": "npm run assets",
    "build": "vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4177 --strictPort",
    "check": "node --test scripts/site.test.mjs"
  },
  "devDependencies": {
    "vite": "^8.3.6"
  },
  "dependencies": {
    "github-slugger": "2.0.0",
    "marked": "18.1.3"
  }
}
